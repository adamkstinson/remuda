# Copy to .env at provisioning. Used by the agentbox container harness, which
# sources this file before starting the agent. The MCP configs (opencode.json,
# .mcp.json) do NOT read it — they carry the literal key.
#
# Anything set here reaches the agent: the harness loads the whole file
# (entrypoint-opencode.js -> loadEnv("/brain/.env")). There is no allow-list.
PLANE_API_KEY=

# Optional. Only for agents that provision or deploy to a DigitalOcean droplet.
# doctl reads this variable directly, so no `doctl auth init` or context is
# needed inside the container. Tokens are scoped to ONE DO team — a token for
# the wrong team fails confusingly rather than loudly, so check
# `doctl account get` reports the team you expect.
DIGITALOCEAN_ACCESS_TOKEN=
