# Secrets slots for this agent. Copy to .env (gitignored) and fill in.
# The runner reads .env on the host. It is never mounted into the sandbox.

# Model provider for Remuda.agent / bare remuda (per-agent, not the host login).
# PI_PROVIDER=anthropic
# PI_MODEL=claude-sonnet-4-5
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
#
# Or put a Pi auth.json at .pi/auth.json (gitignored). That wins over .env keys.
# REMUDA_PI_AUTH=/path/to/auth.json overrides both. Host ~/.pi/agent/auth.json
# is the last fallback.

# Gateway identity (injected into the container as an env tuple)
HTTPS_PROXY=
REMUDA_GATEWAY_TOKEN=
REMUDA_GATEWAY_CA=

# Self-hosted MCP the workflow scripts call on the host
# PLANET_MCP_URL=
# PLANET_MCP_TOKEN=
