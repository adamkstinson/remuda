# Secrets slots for this agent. Copy to .env (gitignored) and fill in.
# The runner reads .env on the host. It is never mounted into the sandbox.

# Gateway identity (injected into the container as an env tuple)
HTTPS_PROXY=
REMUDA_GATEWAY_TOKEN=
REMUDA_GATEWAY_CA=

# Self-hosted MCP the workflow scripts call on the host
# PLANET_MCP_URL=
# PLANET_MCP_TOKEN=
