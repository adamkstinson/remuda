# Secrets slots for this agent. Copy to .env (gitignored) and fill in.
# The runner reads .env on the host. It is never mounted into the sandbox.

# Model auth shortcut if you have not logged in via interactive remuda.
# Before each run the runner writes these keys into .pi/agent/auth.json
# (gitignored), replacing only the providers named here; other logins stay.
# PI_PROVIDER selects which key to write into auth.json. It is not the runtime
# default — Remuda.agent uses Pi's defaultProvider/defaultModel unless the call
# passes provider:/model:.
# PI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
#
# DARKHORSE_API_KEY= gives every ai.darkhorse.so model through the built-in
# darkhorse provider — no PI_PROVIDER or models.json needed.
# DARKHORSE_API_KEY=
#
# Or keep a Pi auth.json at .pi/agent/auth.json (same shape as ~/.pi/agent/auth.json).
# That file is this agent's; Remuda will not copy the host login.

# OAuth MCP servers ("auth": "oauth" in .mcp.json). pi-mcp-adapter's
# encrypted-file store in .pi/agent/mcp-oauth-encrypted/ uses this key; Remuda
# reads the same store on the host. Generate once per agent:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing or rotating it means running /mcp-auth again for every OAuth server.
# PI_MCP_ADAPTER_OAUTH_FILE_KEY=

# Gateway identity (injected into the container as an env tuple)
HTTPS_PROXY=
REMUDA_GATEWAY_TOKEN=
REMUDA_GATEWAY_CA=

# Self-hosted MCP the workflow scripts call on the host
# PLANET_MCP_URL=
# PLANET_MCP_TOKEN=

# Channel tokens named by .remuda/channels.yml (token_env)
# MATTERMOST_TOKEN=
# TEAMS_APP_ID=
# TEAMS_APP_SECRET=
# TEAMS_TENANT_ID=
