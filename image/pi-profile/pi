#!/bin/sh
# Remuda's Pi profile: every Pi in this image loads the MCP client
# (pi-mcp-adapter). The client reads one file, /run/remuda/mcp.json: this run's
# copy of the agent's .mcp.json,
# which the runner mounts as a secret-free copy (see design/08-secrets.md).
PI=/usr/local/bin/pi
ADAPTER=/usr/local/lib/node_modules/pi-mcp-adapter

case "${1:-}" in
  install|remove|uninstall|update|list|config|auth) exec "$PI" "$@" ;;
esac

if [ -f /run/remuda/mcp.json ]; then
  export PI_MCP_CONFIG_MODE=exclusive
  exec "$PI" -e "$ADAPTER" --mcp-config /run/remuda/mcp.json "$@"
fi
exec "$PI" -e "$ADAPTER" "$@"
